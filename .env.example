# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local mongod)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/doctor_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/doctor_tracker

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_doctor_tracker_2026_careguide
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:3000,http://localhost:5173
